# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Required to generate SEBI RA research reports (format INH#########). No default on purpose.
SEBI_RA_REGISTRATION_NUMBER=
# Optional overrides of the standard attestations printed on each report
# SEBI_RA_OWNERSHIP_DISCLOSURE=
# SEBI_RA_CONFLICT_DISCLOSURE=
